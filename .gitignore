.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# OS / editor junk
.DS_Store
.vscode/
.idea/

# Claude Code worktrees
.claude/worktrees/

# Benchmark run artifacts
benchmarks/results/

# Runtime / local artifacts
.env
.env.*
!.env.example
static/uploads/
*.log
*.jsonl
logs/

# Database files
*.db
*.sqlite
*.sqlite3

# User uploads
data/uploads/

# Built UI assets — committed to git so Render doesn't need npm/vite at build time.
# Run `cd ui && npm run build` locally before committing frontend changes.
# static/ui/assets/

# Debug output
static/debug/

# Build / packaging
dist/
build/
*.egg-info/

# Node
node_modules/

# Archives
*.zip

# Jupyter / temp
.ipynb_checkpoints/
tmp/
certs/*.pem

# One-off debug and QA scripts written at the ui/ root. Kept on disk, out of
# the repo — they are scratch from a debugging session, not product code.
/ui/*.mjs
/ui/*qa*.js
/ui/debug-*.js
# Accidental path artifact: a script wrote to a literal Users/... path inside
# ui/, referencing ngw-core, the name retired in favour of ngw-lighting.
/ui/Users/
# Review screenshots live here by convention and are not versioned.
/review-artifacts/
